{
  "name": "trade-blotter-qa",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test framework for a mock trading blotter: UI, API and transaction-integrity tests.",
  "private": true,
  "scripts": {
    "start": "node app/server.js",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
